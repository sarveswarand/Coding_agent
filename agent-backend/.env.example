# Set the key(s) for the provider(s) you want to use; leave the other empty
# (a non-empty placeholder would make that provider look configured).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini has a free tier: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.4-flash-lite

# Remote access (phone app). Run: python -m app.pair --workspace <folder>
AGENT_TOKEN=
AGENT_WORKSPACES=

# Small local model for the voice layer (status summaries); never a cloud model
LOCAL_MODEL=qwen3:1.7b
